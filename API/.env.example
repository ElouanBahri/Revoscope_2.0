# Copy this file to .env and fill in what you use. Nothing here is
# committed with real values.

# --- CORS ---
# Comma-separated list is not supported directly by pydantic-settings' list
# parsing from .env — use a JSON array instead, e.g.:
# CORS_ORIGINS=["http://localhost:5173"]

# --- Admin ---
# 8-digit PIN required to upload a CSV or refresh caches. Leave empty to
# disable those actions. Generate one with:
#   python3 -c "import secrets; print(f'{secrets.randbelow(10**8):08d}')"
ADMIN_PIN=

# --- Binance ---
# Create a Testnet account + API key at https://testnet.binance.vision
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# --- Interactive Brokers ---
# Only needed if your Client Portal Gateway runs somewhere other than
# https://localhost:5000, or you have multiple accounts on one gateway
# session and want to pin one.
IBKR_GATEWAY_URL=https://localhost:5000/v1/api
IBKR_ACCOUNT_ID=

# --- Interactive Brokers (Flex Web Service) ---
# Works on the hosted site (no local gateway). Client Portal → Performance &
# Reports → Flex Queries: create an Activity Flex Query (Trades, Open
# Positions, Cash Transactions, Cash Report; XML; last 365 days), then
# Flex Web Service Configuration → generate a token. Read-only.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=
